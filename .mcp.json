{
  "mcpServers": {
    "elevenlabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY:-set-by-network-secret}",
        "ELEVENLABS_MCP_BASE_PATH": "elevenlabs-output",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    }
  }
}
