{
  "name": "jrm-ad-remakes",
  "private": true,
  "version": "1.0.0",
  "description": "17 s remakes of a REFRESH Orange ad layout for JRM products (Cenanga, Putik)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:cenanga && npm run render:putik",
    "render:cenanga": "remotion render src/index.ts Cenanga out/cenanga_17s.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell",
    "render:putik": "remotion render src/index.ts Putik out/putik_17s.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell"
  },
  "dependencies": {
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/layout-utils": "^4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
